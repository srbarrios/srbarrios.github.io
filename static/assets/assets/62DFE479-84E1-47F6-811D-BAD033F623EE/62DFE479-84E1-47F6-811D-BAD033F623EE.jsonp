"text":"      ➔ RETURN 🟢 FIXED (Healed)","targetRectangle":{"y":200.03319776058197,"x":406.10446393489838,"width":135.0341796875,"height":12}},{"text":"   ELSE ","targetRectangle":{"y":212.03319776058197,"x":406.10446393489838,"width":33.60546875,"height":8}},{"text":"      ➔ RETURN 🟠 FLAKY (Sporadic \/ Cluster)","targetRectangle":{"y":220.03319776058197,"x":406.10446393489838,"width":185.4423828125,"height":12}},{"text":"\/\/ 3. HARD REGRESSIONS","targetRectangle":{"y":240.03319776058197,"x":406.10446393489838,"width":92.4150390625,"height":8}},{"text":"IF passing_now AND max_streak > 6 ","targetRectangle":{"y":248.03319776058197,"x":406.10446393489838,"width":142.8232421875,"height":8}},{"text":"   ➔ RETURN 🟢 FIXED (Resolved Regression)","targetRectangle":{"y":256.03319776058197,"x":406.10446393489838,"width":177.041015625,"height":12}},{"text":"IF failing_now AND current_fails >= 3 ","targetRectangle":{"y":276.03319776058197,"x":406.10446393489838,"width":159.6259765625,"height":8}},{"text":"   ➔ RETURN 🔴 REGRESSION (Active)","targetRectangle":{"y":284.03319776058197,"x":406.10446393489838,"width":143.435546875,"height":12}},{"text":"\/\/ 4. CATCH-ALL","targetRectangle":{"y":304.03319776058197,"x":406.10446393489838,"width":63.01025390625,"height":8}},{"text":"ELSE ","targetRectangle":{"y":312.03319776058197,"x":406.10446393489838,"width":21.00341796875,"height":8}},{"text":"   ➔ RETURN ⚪ AMBIGUOUS","targetRectangle":{"y":320.03319776058197,"x":406.10446393489838,"width":101.4287109375,"height":12}},{"text":"Google Shape;219;g3d5c954a7fe_0_12","targetRectangle":{"y":71.692649841308594,"x":177.3011780096289,"width":209.12126159667966,"height":289.147705078125}},{"text":"Google Shape;212;g3d5c954a7fe_0_12","targetRectangle":{"y":357.82522821426392,"x":488.04952597618103,"width":13.277716636657715,"height":13.279764175415039}},{"text":"Google Shape;18;p19","targetRectangle":{"y":366.10379028320312,"x":135.50299072265625,"width":197.13606262207031,"height":24.0944099