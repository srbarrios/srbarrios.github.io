:499.76866227388382,"width":216.63789221191405,"height":25.5}},{"text":"INPUT:   history[] (0 = Pass, >0 = Fail)","targetRectangle":{"y":88.03319776058197,"x":406.10446393489838,"width":168.02734375,"height":8}},{"text":"METRICS: fail_rate, transitions, max_streak, recency","targetRectangle":{"y":96.03319776058197,"x":406.10446393489838,"width":218.435546875,"height":8}},{"text":"\/\/ 1. INFRASTRUCTURE DEAD","targetRectangle":{"y":112.03319776058197,"x":406.10446393489838,"width":105.01708984375,"height":8}},{"text":"IF fail_rate == 100% ","targetRectangle":{"y":120.03319776058197,"x":406.10446393489838,"width":88.21435546875,"height":8}},{"text":"   ➔ RETURN 🔴 ENVIRONMENTAL","targetRectangle":{"y":128.03319776058197,"x":406.10446393489838,"width":118.2314453125,"height":12}},{"text":"\/\/ 2. INSTABILITY \/ FLAKINESS","targetRectangle":{"y":148.03319776058197,"x":406.10446393489838,"width":121.81982421875,"height":8}},{"text":"IF transitions >= 3 ","targetRectangle":{"y":156.03319776058197,"x":406.10446393489838,"width":84.013671875,"height":8}},{"text":"   ➔ RETURN 🟠 FLAKY (Oscillation)","targetRectangle":{"y":164.03319776058197,"x":406.10446393489838,"width":143.435546875,"height":12}},{"text":"IF (fail_rate < 30%) OR (max_streak <= 6 AND passing_now):","targetRectangle":{"y":184.03319776058197,"x":406.10446393489838,"width":243.6396484375,"height":8}},{"text":"   IF recency > 48 runs ","targetRectangle":{"y":192.03319776058197,"x":406.10446393489838,"width":100.81640625,"height":8}},{"text":"      ➔ RETURN 🟢 FIXED (Healed)","targetRectangle":{"y":200.03319776058197,"x":406.10446393489838,"width":135.0341796875,"height":12}},{"text":"   ELSE ","targetRectangle":{"y":212.03319776058197,"x":406.10446393489838,"width":33.60546875,"height":8}},{"text":"      ➔ RETURN 🟠 FLAKY (Sporadic \/ Cluster)","targetRectangle":{"y":220.03319776058197,"x":406.10446393489838,"width":185.4423828125,"height":12}},{"text":"\/\/ 3. HARD REGRESSIONS","targetRectangle":{"y":240.03319776058197,"x":406.10446393489838,"width":92.4150390625,"height":8}},{"text":"IF passing_now AND max_streak > 6 ","targetRectangle":{"y":248.03319776058197,"x":406.10446393489838,"width":142.8232421875,"height":8}},{"text":"   ➔ RETURN 🟢 FIXED (Resolved Regression)","targetRectangle":{"y":256.03319776058197,"x":406.10446393489838,"width":177.041015625,"height":12}},{"text":"IF failing_now AND current_fails >= 3 ","targetRectangle":{"y":276.03319776058197,"x":406.10446393489838,"width":159.6259765625,"height":8}},{"text":"   ➔ RETURN 🔴 REGRESSION (Active)","targetRectangle":{"y":284.03319776058197,"x":406.10446393489838,"width":143.435546875,"height":12}},{"text":"\/\/ 4. CATCH-ALL","targetRectangle":{"y":304.03319776058197,"x":406.10446393489838,"width":63.01025390625,"height":8}},{"text":"ELSE ","targetRectangle":{"y":312.03319776058197,"x":406.10446393489838,"width":21.00341796875,"height":8}},{"text":"   ➔ RETURN ⚪ AMBIGUOUS","targetRectangle":{"y":320.03319776058197,"x":406.10446393489838,"width":101.4287109375,"height":12}},{"text":"Google Shape;219;g3d5c954a7fe_0_12","targetRectangle":{"y":71.692649841308594,"x":177.3011780096289,"width":209.12126159667966,"height":289.147705078125}},{"text":"Google Shape;212;g3d5c954a7fe_0_12","targetRectangle":{"y":357.82522821426392,"x":488.04952597618103,"width":13.277716636657715,"height":13.279764175415039}},{"text":"Restores CI stability by accurately identifying flaky test patterns.","targetRectangle":{"y":227.68031406402588,"x":56.147076964378357,"width":500.29018286132805,"height":34.5}},{"text":"Code rules catch most flakes, pragmatically saving AI tokens.","targetRectangle":{"y":262.18031406402588,"x":56.147076964378357,"width":479.72344921874992,"height":34.5}},{"text":"LLM analyzes only complex patterns, exporting JSON for Grafana dashboards.","targetRectangle":{"y":296.68031406402588,"x":56.147076964378357,"width":604.20148242187474,"height":34.5}},{"text":"Google Shape;18;p19","targetRectangle":{"y":366.103790283203